# ==============================================================================
# Biến môi trường mẫu cho Hệ thống trợ lý cuộc họp & bài giảng tiếng Việt
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_DB=meeting
POSTGRES_USER=meeting
POSTGRES_PASSWORD=change_this_to_a_secure_random_password
DATABASE_URL=postgresql+psycopg://meeting:change_this_to_a_secure_random_password@postgres:5432/meeting

# Redis (Broker Celery & Pub/Sub)
REDIS_URL=redis://redis:6379/0

# Xác thực & Bảo mật (JWT & Hash)
JWT_SECRET=change_this_to_a_random_secret_at_least_32_bytes_long
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Hugging Face (Pyannote Diarization 3.1)
HF_TOKEN=your_huggingface_token_here
HF_HOME=/cache/huggingface

# Faster-Whisper
WHISPER_MODEL=large-v3-turbo
WHISPER_DRAFT_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_DRAFT_BEAM_SIZE=1

# LLM (OpenAI-Compatible endpoint)
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=not_needed_for_local_or_your_key
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_JSON_MODE=true

# Lưu trữ & Giới hạn dữ liệu
DATA_DIR=/data
MAX_DURATION_SECONDS=10800
MAX_OPUS_BYTES=67108864
MAX_ORIGINAL_BYTES=524288000

# GPU & Bộ nhớ CUDA
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Nhận diện giọng nói (Voice Profile Match)
VOICE_MATCH_THRESHOLD=0.75
VOICE_MATCH_MARGIN=0.05
